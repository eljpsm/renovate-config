{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "group:allNonMajor",
    "group:allDigest",
    ":enableVulnerabilityAlerts",
    ":automergeStableNonMajor"
  ],
  "timezone": "Pacific/Auckland",
  "schedule": ["* 0-4 * * 1"],
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "prConcurrentLimit": 5,
  "reviewersFromCodeOwners": true,
  "packageRules": [
    {
      "description": "Lock file maintenance and replacements have no release timestamp, so the minimum release age would hold them back forever",
      "matchUpdateTypes": ["lockFileMaintenance", "replacement"],
      "minimumReleaseAge": null
    },
    {
      "description": "Group pre-1.0 updates separately so they don't block automerge of stable updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "/^v?0\\./",
      "groupName": "pre-1.0 dependencies",
      "automerge": false
    }
  ],
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "assignees": ["eljpsm"],
    "schedule": "at any time"
  }
}
